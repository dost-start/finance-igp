# Copy to .env.local and fill in. Never commit real values.
# Supabase: Connect > Transaction pooler (port 6543), password filled in
DATABASE_URL=
# Google Cloud OAuth web client (admin sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Drive receipts: refresh token from the OAuth Playground, folder created by scripts/create-drive-folder.mjs
DRIVE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=
# Gmail sending (finance Gmail + 16-character app password, no spaces)
SMTP_USER=
SMTP_PASS=
# Site and links
NEXT_PUBLIC_SITE_URL=https://start-shop-six.vercel.app
MERCH_TICKET_FORM_URL=
# Comma-separated Gmail addresses seeded as admin accounts
SEED_ADMIN_EMAILS=

# Values only finance can give. Left empty on purpose: while empty, the matching admin action is
# switched off with a plain message (no invented number is ever sent to a buyer).
# Refund timeframe text for Email 7, in the words finance wants buyers to read.
REFUND_TIMEFRAME=
# Hours buyers have to send a new receipt after a rejection (Email 9), a whole number.
REJECTION_DEADLINE_HOURS=
